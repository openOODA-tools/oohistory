// # Root Verification Anchor for oohistory
//
// Logline: Top-level integration test orchestrating core, render, and ipc subsystem anchors.
//
// Setup: Demands zero ambient authority, verifying pure redaction, hash chaining, and ledger logic.
//
// Beats:
//   1. Verify core credential redaction, hash chaining, and tamper detection.
//   2. Verify render subsystem table formatting, audit reports, and JSON serialization.
//   3. Verify ipc subsystem argument parsing, JSON decoding, and character escaping.
//   4. Export top-level system verification routine for test harness.

import "core/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

pub fn verify_all() -> Bool {
    if !verify_core() {
        return false;
    }
    if !verify_render() {
        return false;
    }
    if !verify_ipc() {
        return false;
    }
    return true;
}
